# Copie para .env. Valores para desenvolvimento local (BFF no host, serviços nos composes deles);
# na nuvem, use os segredos da plataforma e gere chaves novas (openssl rand -hex 32).

PORT=3000
MERCHANT_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082

# Function calculate-fees (func start: http://localhost:7071/api/fees). Vazio = taxas null com aviso no painel.
FEES_FUNCTION_URL=
FEES_FUNCTION_KEY=

# Igual ao PAYFLOW_INTERNAL_KEY do merchant-service e do payment-service.
INTERNAL_KEY=local-dev-internal-key-0123456789abcdef

# Vazio = sem checagem do API Gateway (desenvolvimento). Na nuvem, o mesmo valor configurado no Gateway.
GATEWAY_ORIGIN_SECRET=

# Administração de lojistas (GET/PUT/DELETE /merchants...). Vazio = desligada.
ADMIN_KEY=local-dev-admin-key-0123456789abcdef

# Origens do frontend que podem chamar o BFF direto (separadas por vírgula).
CORS_ORIGIN=http://localhost:5173

UPSTREAM_TIMEOUT_MS=2000
PROXY_TIMEOUT_MS=10000
LOG_LEVEL=info
